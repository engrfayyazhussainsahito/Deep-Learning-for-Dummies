{
  "name": "deep-learning-course",
  "version": "1.0.0",
  "description": "Open, graduate-level Deep Learning course (18 weeks): notes, derivations, code, diagrams and interactive demos, built as a static website.",
  "scripts": {
    "build": "node build.js",
    "serve": "node build.js && python3 -m http.server 8000 --directory site",
    "check": "node build.js --check=1"
  },
  "keywords": [
    "deep-learning",
    "course",
    "open-education",
    "pytorch",
    "machine-learning"
  ],
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0"
  },
  "private": false,
  "engines": {
    "node": ">=18"
  }
}
